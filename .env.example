# Backbricks configuration (validated at startup by packages/core/src/config).
# Copy to `.env` for runs on the host. The values below match the dev services in compose.yaml
# (`mise run infra`); they are dev-only and must never be used in production.
#
# Every variable can also be given as <NAME>_FILE pointing to a file (Docker secrets);
# setting both <NAME> and <NAME>_FILE is an error.

# --- Modules -------------------------------------------------------------------------------
# Comma-separated module types to enable: forms, uploads, reviews. Unset or empty = all.
# Storage and scanner variables are only required by modules that need them (ADR-0019).
BACKBRICKS_MODULES=forms,uploads,reviews

# --- Core (always required) -----------------------------------------------------------------
# development | test | production (default: production)
NODE_ENV=development
# self_hosted | cloud (default: self_hosted)
DEPLOYMENT_MODE=self_hosted
DATABASE_URL=postgres://backbricks:backbricks@localhost:5432/backbricks
# At least 32 characters, e.g. `openssl rand -hex 32`.
APP_SECRET=dev-only-app-secret-change-me-0000000000
# Public browser URL. Vite proxies the API in development; use :3000 for a built dashboard.
# Production requires an https:// URL. Default if unset: http://localhost:3000.
PUBLIC_URL=http://localhost:5173
# Comma-separated literal proxy IPs. Empty ignores forwarded headers; no hostnames or CIDRs.
# Trusted proxies must append/overwrite X-Forwarded-For with the actual connecting address.
TRUSTED_PROXIES=
# Default invite_only. Open is selected here only for development with Mailpit.
# Production first-admin setup is implemented in M6.
SIGNUP_POLICY=open
# HTTP port of the `serve` role. Default: 3000
PORT=3000
# fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=debug

# --- Email (optional) -----------------------------------------------------------------------
# Without SMTP, invitations fall back to copyable links. MAIL_FROM (an email address) is
# required with SMTP_URL.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=noreply@backbricks.localhost

# --- Object storage (required when uploads is enabled) -------------------------------------
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=backbricks
S3_ACCESS_KEY_ID=GKbac4b41c4500000000000000
S3_SECRET_ACCESS_KEY=bac4b41c45000000000000000000000000000000000000000000000000000000
# true for Garage/MinIO-style path URLs. Default: false
S3_FORCE_PATH_STYLE=true

# --- Malware scanner (used by uploads) ------------------------------------------------------
# none | clamav (default: none; files are then marked "not scanned" in the dashboard)
SCANNER=none
# Required when SCANNER=clamav. Start ClamAV with `docker compose --profile scan up -d clamav`.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

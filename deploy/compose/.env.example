# Generate the actual .env and optional Garage settings with backbricks deploy configure.
BACKBRICKS_IMAGE=backbricks/server:local
PUBLIC_URL=https://backbricks.example.com
CADDY_HOST=backbricks.example.com
BACKBRICKS_MODULES=forms
COMPOSE_PROFILES=tls
POSTGRES_PASSWORD=
APP_SECRET=
# The generated passwords and keys contain URL-safe hexadecimal characters.
# BACKBRICKS_LOCAL_PORT=3000
# SMTP_URL=smtps://...
# MAIL_FROM=backbricks@example.com

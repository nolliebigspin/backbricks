{
  "name": "@backbricks/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript SDK for websites and servers",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "browser": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/src/index.js"
    },
    "./admin": {
      "types": "./admin/index.ts",
      "browser": "./admin/index.ts",
      "bun": "./admin/index.ts",
      "default": "./dist/admin/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "bun tools/build.ts",
    "test": "bun run build && bun test"
  },
  "dependencies": {
    "@backbricks/api-contract": "workspace:*",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "altcha-lib": "2.8.0"
  },
  "engines": {
    "node": ">=20"
  }

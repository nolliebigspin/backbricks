{
  "name": "backbricks",
  "version": "0.0.0",
  "private": true,
  "description": "Backbricks CLI and MCP server",
  "license": "MIT",
  "bin": {
    "backbricks": "./dist/backbricks.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "bun build ./src/index.ts --target=node --conditions=bun --outfile ./dist/backbricks.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun run build && bun test"
  },
  "dependencies": {
    "@backbricks/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "commander": "14.0.3",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=20"
  }
}

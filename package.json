{
  "name": "backbricks-monorepo",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/modules/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "tsc -p tsconfig.json && turbo run typecheck",
    "test": "turbo run test && bun run test:scripts",
    "test:scripts": "bun test ./scripts",
    "test:e2e": "turbo run test:e2e",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run format:check && bun run lint && bun run lint:arch && bun run typecheck && bun run test",
    "check:affected": "bun run format:check && bun run lint && bun run lint:arch && bun run typecheck && turbo run test --affected && bun run test:scripts",
    "lint:arch": "depcruise apps packages --config .dependency-cruiser.json"
  },
  "devDependencies": {
    "@shadcn/lint": "0.2.5",
    "@swc/core": "1.16.21",
    "@types/bun": "1.4.4",
    "dependency-cruiser": "18.7.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.4"
}

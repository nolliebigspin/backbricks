{
  "name": "backbricks-monorepo",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/modules/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "auth:generate": "bun scripts/auth/generate.ts",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "tsc -p tsconfig.json && turbo run typecheck",
    "test": "turbo run test && bun run test:scripts",
    "test:scripts": "bun test ./scripts",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run format:check && bun run lint && bun run lint:arch && bun run api:check && bun run api:breaking && bun run typecheck && bun run test",
    "check:affected": "bun run format:check && bun run lint && bun run lint:arch && bun run api:check && bun run api:breaking && bun run typecheck && turbo run test --affected && bun run test:scripts",
    "lint:arch": "depcruise apps packages --config .dependency-cruiser.json",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun apps/server/src/main.ts migrate",
    "api:generate": "bun scripts/api/generate.ts",
    "api:check": "bun scripts/api/check.ts",
    "api:breaking": "bun scripts/api/breaking.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1163.0",
    "@playwright/test": "1.65.0",
    "@shadcn/lint": "0.2.5",
    "@swc/core": "1.16.22",
    "@types/bun": "1.4.4",
    "@types/pg": "8.23.1",
    "dependency-cruiser": "18.7.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "pg": "8.23.1",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  },
  "packageManager": "bun@1.4.4"
}

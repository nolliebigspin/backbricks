{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "plugins": [{ "name": "next" }],
    "allowJs": true,
    "incremental": true,
    "esModuleInterop": true,
    "types": ["bun", "react", "react-dom"]
  },
  "include": ["next-env.d.ts", "app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", ".next/types/**/*.ts"]
}

---
import { Prism } from '@astrojs/prism';

import { Bricks } from '../components/bricks.tsx';
import { Faq } from '../components/faq.tsx';
import { Hero } from '../components/hero.tsx';
import { HowItWorks } from '../components/how-it-works.tsx';
import { IntegrationExamples } from '../components/integration-examples.tsx';
import { OpenSource } from '../components/open-source.tsx';
import { SafeDefaults } from '../components/safe-defaults.tsx';
import { Section } from '../components/section.tsx';
import { integrationSamples } from '../content/snippets.ts';
import BaseLayout from '../layouts/base-layout.astro';
import { landingNodes } from '../lib/structured-data.ts';

const tabs = integrationSamples.map(({ id, label }) => ({ id, label }));
---

<BaseLayout structuredData={landingNodes()}>
  <Hero />
  <Bricks />
  <HowItWorks />
  <Section
    title="Start with your own markup"
    intro="Post a form directly or use the TypeScript SDK for inline validation, private attachments, and published reviews."
  >
    <IntegrationExamples client:visible tabs={tabs}>
      {
        integrationSamples.map((sample) => (
          <Prism slot={sample.id} class="code-block" lang={sample.lang} code={sample.code} />
        ))
      }
    </IntegrationExamples>
    <p class="mt-5 text-sm text-muted-foreground">
      <a href="/docs/html" class="text-brand underline underline-offset-4">Set up a plain HTML form</a>
      or follow the <a href="/docs/forms#submit-with-the-sdk" class="text-brand underline underline-offset-4">SDK quickstart</a>.
    </p>
  </Section>
  <SafeDefaults />
  <OpenSource />
  <Section id="faq" title="Frequently asked questions">
    <div class="max-w-3xl">
      <Faq />
    </div>
  </Section>
</BaseLayout>

---
import Head from '@astrojs/starlight/components/Head.astro';

import { publicPageUrl } from '../content/site.ts';

const canonical = publicPageUrl(Astro.url.pathname).href;
for (const { attrs } of Astro.locals.starlightRoute.head) {
  if (attrs?.['rel'] === 'canonical') attrs['href'] = canonical;
  if (attrs?.['property'] === 'og:url') attrs['content'] = canonical;
}

// Starlight's theme, search and sidebar include static inline scripts. Authorize
// their exact pinned bytes on documentation pages without changing marketing CSP.
for (const hash of [
  'sha256-CucRf0bf0xYD/oKdMuRRn1yhi9AJeUlkP4LSbkp47Ls=',
  'sha256-f/zAUE74ucc3JYp4r4QQvkJofoQdkOIhHYK+jeZ6eko=',
  'sha256-yiTapURQAzVYqJIJXL03Gepg/022hHZUVvS4f8isCN8=',
  'sha256-wX2yOADeV+NMngflD5uYi3vl50SHC4sfM1EmylVjlX4=',
  'sha256-7eCV4jtsr4t4knb3c4FCRPeu7GGZeOUGE3XvWix0XOQ=',
] as const) Astro.csp?.insertScriptHash(hash);

for (const hash of [
  'sha256-VYLa8fO3Sg6dJRXXw7VIjyTkcNLC4IuPCz1UPV1OKy0=',
  'sha256-ZdHxw9eWtnxUb3mk6tBS+gIiVUPE3pGM470keHPDFlE=',
  'sha256-AjpxHAnhAkbI3p301rAQ19y+QSGq2Jl7vv0Q7WzjR+c=',
  'sha256-EOZ7IwL6g2pUr/BQpb9n6VhOtvHLk6UMtjwgNikSHTw=',
  'sha256-4nwmP7y2Oqil2yoHYBvRn7OImAddhzMs7BiQ3EXY2ls=',
  'sha256-wrvMNywJ/dvSTFeuRqdBZPkNpA9KJjNVehBzjKFXP5A=',
  'sha256-N0U7UbX70ebuNVEQiGcI+KTCoqytKKf6vbasn4H+n3A=',
  'sha256-r2WEacw89sPmp/OD8a8qTrigv6kSvYZXLpAnutU3xjQ=',
] as const) Astro.csp?.insertStyleHash(hash);
---
<Head {...Astro.props} />

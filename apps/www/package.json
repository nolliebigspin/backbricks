    "@astrojs/starlight": "0.43.1",
    "@backbricks/ui": "workspace:*",
    "@scalar/api-reference": "1.83.0",
    "@tailwindcss/vite": "4.3.5",
    "@vercel/analytics": "2.0.1",
    "astro": "7.4.13",
    "lucide-react": "1.77.0",
    "prismjs": "1.30.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {

{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "react", "jsx-a11y", "node"],
  "jsPlugins": ["@shadcn/lint"],
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "no-console": "error",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/consistent-type-imports": "error",
    "import/no-cycle": "error",
    "import/no-default-export": "error",
    "react/no-danger": "error",
    "node/no-process-env": "error",
    "no-restricted-properties": [
      "error",
      {
        "object": "Bun",
        "property": "env",
        "message": "Read configuration through @backbricks/core config, not Bun.env (AGENTS.md §2.2)."
      }
    ],
    "react/jsx-no-target-blank": "error",
    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout"]
      }
    ],
    "shadcn/no-raw-colors": "error",
    "shadcn/no-arbitrary-values": "error",
    "shadcn/no-inline-styles": "error",
    "shadcn/no-unknown-classes": "error",
    "shadcn/require-static-classes": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["scripts/**", "**/*.config.ts", "**/*.config.js", "**/vite.config.ts"],
      "rules": {
        "no-console": "off",
        "import/no-default-export": "off"
      }
    },
    {
      "files": [
        "packages/core/src/config/**",
        "scripts/**",
        "**/*.config.ts",
        "**/*.config.js",
        "**/*.test.ts",
        "**/test/**"
      ],
      "rules": {
        "node/no-process-env": "off",
        "no-restricted-properties": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/e2e/**"],
      "rules": {
        "typescript/no-explicit-any": "warn"
      }
    },
    {
      "files": [
        "apps/*/src/index.ts",
        "packages/*/src/index.ts",
        "packages/modules/*/src/index.ts"
      ],
      "rules": {
        "unicorn/no-empty-file": "off"
      }
    },
    {
      "files": ["packages/ui/src/components/**"],
      "rules": {
        "shadcn/no-restyle": "off",
        "shadcn/no-arbitrary-values": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.turbo/**",
    ".codegraph/**",
    "scripts/arch/fixtures/**",
    "apps/web/src/routeTree.gen.ts",
    "packages/api-contract/src/generated/**",
    "packages/db/migrations/**"
  ],
  "settings": {
    "shadcn": {
      "ui": "@backbricks/ui",
      "themeImports": ["^@backbricks/ui/"]
    }
  }
}
